define_constants;
clc;

mpopt = mpoption( ...
    'pf.alg', 'NR', ...
    'pf.tol', 1e-8, ...
    'pf.nr.max_it', 20, ...
    'pf.enforce_q_lims', 0, ...
    'verbose', 0, ...
    'out.all', 0);

cases = {'case14', 'case30', 'case57', 'case118'};

output_dir = 'reference_results';

if ~exist(output_dir, 'dir')
    mkdir(output_dir);
end

for k = 1:numel(cases)

    case_name = cases{k};
    case_file = fullfile('data', [case_name '.m']);

    mpc = loadcase(case_file);

% Save original bus voltage angles
original_va = mpc.bus(:, VA);

    % Explicit flat start
    mpc.bus(:, VM) = 1.0;
    mpc.bus(:, VA) = 0.0;

    % Restore original slack bus angle
    ref_idx = find(mpc.bus(:, BUS_TYPE) == REF);
    mpc.bus(ref_idx, VA) = original_va(ref_idx);

    % Restore PV and reference voltage setpoints
    for g = 1:size(mpc.gen, 1)
        if mpc.gen(g, GEN_STATUS) <= 0
            continue;
        end

        bus_number = mpc.gen(g, GEN_BUS);
        bus_idx = find(mpc.bus(:, BUS_I) == bus_number, 1);

        if mpc.bus(bus_idx, BUS_TYPE) == PV || ...
           mpc.bus(bus_idx, BUS_TYPE) == REF
            mpc.bus(bus_idx, VM) = mpc.gen(g, VG);
        end
    end

    [res, success] = runpf(mpc, mpopt);

    if ~success
        error('MATPOWER failed to converge for %s', case_name);
    end

    % Prepare reference data
    ref.bus.bus_id = res.bus(:, BUS_I)';
    ref.bus.Vm = res.bus(:, VM)';
    ref.bus.Va = res.bus(:, VA)';

    ref.branch.from_bus = res.branch(:, F_BUS)';
    ref.branch.to_bus = res.branch(:, T_BUS)';
    ref.branch.PF = res.branch(:, PF)';
    ref.branch.QF = res.branch(:, QF)';
    ref.branch.PT = res.branch(:, PT)';
    ref.branch.QT = res.branch(:, QT)';

    ref.summary.iterations = res.iterations;
    ref.summary.total_p_loss_mw = sum(res.branch(:, PF) + res.branch(:, PT));
    ref.summary.total_q_loss_mvar = sum(res.branch(:, QF) + res.branch(:, QT));

    % Write JSON
    output_file = fullfile(output_dir, [case_name '.json']);

    fid = fopen(output_file, 'w');

    if fid == -1
        error('Cannot create file: %s', output_file);
    end

    fprintf(fid, '%s', jsonencode(ref));
    fclose(fid);

    fprintf('%s converged in %d iterations. Saved: %s\n', ...
        case_name, res.iterations, output_file);

end

disp('All reference files generated.');